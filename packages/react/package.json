{
  "name": "@inshapardaz/likhari-react",
  "version": "0.1.31",
  "description": "React implementation of the Likhari editor, built on @lexical/react.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/inshapardaz/likhari"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/theme/editor.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-esm-extensions.mjs ./dist && node ../../scripts/copy-assets.mjs src dist \"**/*.css\" && node ../../scripts/copy-assets.mjs src dist \"**/*.aff\" && node ../../scripts/copy-assets.mjs src dist \"**/*.dic\" && node ../../scripts/copy-assets.mjs src dist \"**/*.txt\"",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@inshapardaz/likhari-converters": "^0.1.0",
    "@inshapardaz/likhari-core": "^0.1.0",
    "@lexical/link": "^0.20.0",
    "@lexical/list": "^0.20.0",
    "@lexical/react": "^0.20.0",
    "@lexical/rich-text": "^0.20.0",
    "@lexical/selection": "^0.20.0",
    "@lexical/table": "^0.20.0",
    "@lexical/utils": "^0.20.0",
    "@tabler/icons-react": "^3.46.0",
    "lexical": "^0.20.0",
    "nspell": "^2.1.5"
  },
  "peerDependencies": {
    "@mantine/core": "^9.7.0",
    "@mantine/hooks": "^9.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@mantine/core": "^9.7.0",
    "@mantine/hooks": "^9.7.0",
    "@types/nspell": "^2.1.6"
  }
}
