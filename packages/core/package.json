{
  "name": "@inshapardaz/likhari-core",
  "version": "0.1.8",
  "description": "Framework-agnostic pieces of the Likhari editor: feature-config schema, presets, and default theme tokens.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/inshapardaz/likhari"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-esm-extensions.mjs ./dist",
    "prepublishOnly": "npm run build"
  }
}
