{
  "name": "likhari",
  "private": true,
  "version": "0.0.0",
  "description": "An Urdu-first multilingual rich text editor, built on Lexical.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace apps/demo",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/inshapardaz/likhari"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}