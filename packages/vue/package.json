{
  "name": "@inshapardaz/likhari-vue",
  "version": "0.1.2",
  "description": "Vue 3 component for the Likhari editor, a thin wrapper over the <likhari-editor> Web Component.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/inshapardaz/likhari"
  },
  "type": "module",
  "main": "./dist/likhari-vue.js",
  "module": "./dist/likhari-vue.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/likhari-vue.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run build --workspace @inshapardaz/likhari-webcomponent && vite build && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@inshapardaz/likhari-converters": "*",
    "@inshapardaz/likhari-core": "*",
    "@inshapardaz/likhari-webcomponent": "*"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^5.4.10",
    "vue": "^3.5.43"
  }
}
