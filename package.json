{
  "name": "likhari",
  "private": true,
  "version": "0.0.0",
  "description": "An Urdu-first multilingual rich text editor, built on Lexical.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace apps/demo",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:build": "E2E_BUILD=1 playwright test -c e2e/playwright.config.ts",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --pretty"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/inshapardaz/likhari"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
